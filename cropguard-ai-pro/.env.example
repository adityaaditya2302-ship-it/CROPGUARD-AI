# CropGuard AI Pro - Environment Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production

# Model Configuration
MODEL_PATH=static/models/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,tif,tiff

# Weather API (Open-Meteo is free, no key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Database
DATABASE_URL=sqlite:///cropguard.db

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Drone Processing
DRONE_MAX_IMAGES=100
GPS_LOG_MAX_SIZE=52428800

# Live Drone Connectivity (WiFi + Bluetooth)
# Leave DRONE_API_KEY empty to allow any device to connect (easiest to get
# started). Set it once you want to require an X-Drone-Api-Key header.
DRONE_API_KEY=
DRONE_DEVICE_TIMEOUT_SECONDS=30
ENABLE_WIFI_DISCOVERY=true
