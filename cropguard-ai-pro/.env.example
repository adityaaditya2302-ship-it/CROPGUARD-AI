# ======================================================================
# CropGuard AI Pro v4.0 - Environment Configuration
# Phase 0-5: AI Precision Agriculture Platform
# Copy this file to .env and fill in your values
# ======================================================================

# ── Core Flask ─────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# ── Phase 0: AI Models ────────────────────────────────────────────────
MODEL_PATH=static/models/best.pt          # YOLOv8 detection model
MODEL_PATH_V2=                            # YOLOv8 v2 (optional)
MODEL_PATH_V3=                            # YOLOv8 v3 (optional)
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Phase 0: Ensemble AI weights (leave blank if not fine-tuned yet)
EFFICIENTNET_WEIGHTS=                     # Path to fine-tuned EfficientNetV2 .pt file
SWIN_WEIGHTS=                             # Path to fine-tuned Swin Transformer .pt file

# Phase 4: Weed/Pest models (leave blank to use heuristic fallback)
WEED_MODEL_WEIGHTS=                       # Path to weed detection YOLO .pt
PEST_MODEL_WEIGHTS=                       # Path to pest detection YOLO .pt

# ── Upload Settings ────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=16777216               # 16MB max upload
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,tif,tiff

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///cropguard.db       # Development
# DATABASE_URL=postgresql://user:pass@localhost:5432/cropguard  # Production

# ── Phase 2: AI Farm Assistant ────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                           # Gemini Pro API (recommended)
OPENAI_API_KEY=                           # GPT-4o fallback (optional)

# ── Phase 2: Weather Intelligence ─────────────────────────────────────
# Open-Meteo is FREE - no API key needed!
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Optional OpenWeatherMap for extra features:
OPENWEATHERMAP_API_KEY=

# ── Phase 3: Drone (MAVLink) ──────────────────────────────────────────
DRONE_CONNECTION=udp://:14540             # Change for your drone
DRONE_API_KEY=                            # Set to restrict access
DRONE_DEVICE_TIMEOUT_SECONDS=30
ENABLE_WIFI_DISCOVERY=true
DRONE_MAX_IMAGES=100
GPS_LOG_MAX_SIZE=52428800

# ── Phase 3: IoT Sensors (MQTT) ────────────────────────────────────────
MQTT_BROKER=broker.hivemq.com            # Free public broker for dev
MQTT_PORT=1883
# MQTT_USERNAME=                         # Set for private broker
# MQTT_PASSWORD=

# ── Phase 5: Farm Memory ───────────────────────────────────────────────
FARM_MEMORY_DIR=farm_memory              # Local JSON storage (dev)
# Upgrade to MongoDB for production:
# MONGODB_URI=mongodb://localhost:27017/cropguard

# ── Task Queue ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Phase 4: Satellite (Optional) ─────────────────────────────────────
# Get at: https://www.sentinel-hub.com/
# SENTINELHUB_CLIENT_ID=
# SENTINELHUB_CLIENT_SECRET=

# ── Phase 5: Carbon Credits ────────────────────────────────────────────
CARBON_CREDIT_PRICE_USD=15.0
INR_USD_RATE=83.0
